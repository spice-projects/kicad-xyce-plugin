# Build directories (CMake presets write to .build-*)
.build-*/
build/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
build.ninja
.ninja_deps
.ninja_log
artifacts/
Testing/

# vcpkg
/vcpkg_installed/
vcpkg-manifest-install.log

# Compiled executables and objects
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe
*.moc

# Profile / coverage data
*.prof
*.profdata
*.profraw
*.gcda
*.gcno

# Clangd / editor index cache
.clangd/

# IDE and editor files
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
.DS_Store
*.swp
*~

# KiCad / Xyce generated output
*.raw
*.fft*

# Xyce text/log outputs
*.y0
*.print_*

# ImageMagick-style temporary/backup files
*~.orig
*.orig
*.rej

# ImGui layout/status files
imgui.ini
src/ui/imgui.ini

# Fonts: keep source TTFs in git, ignore generated subsets
src/ui/fonts/*.ttf
!src/ui/fonts/Inter-Regular.ttf

# Python (legacy package, tracked sources only)
*.pyc
__pycache__/
.pytest_cache/
.coverage
*.egg-info/
.venv/

# Local environment file (use template.env as a reference)
.env

# Distribution / packaging output
dist/

# KiCad vendored icon trees that are copied in, not authored here
/kicad-icons
