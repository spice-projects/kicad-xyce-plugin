import { Button, LineEdit, Palette, StandardButton } from "std-widgets.slint";
import { ExpressionItem, ExpressionGrid, Legend, LegendItem } from "../components/expression_selector.slint";

// macOS-style additive-plot picker: filter, chip grid, optional custom
// expression entry, legend, and standard OK/Cancel actions.
export component AddPlotDialog inherits Dialog {
    title: "Select Plot Expressions";

    in-out property <[ExpressionItem]> expressions: [
        { name: "V(out)", type: "Voltage", selected: true },
        { name: "V(in)", type: "Voltage", selected: true },
        { name: "V(fb)", type: "Voltage", selected: false },
        { name: "I(R1)", type: "Current", selected: false },
        { name: "I(C1)", type: "Current", selected: false },
        { name: "I(L1)", type: "Current", selected: false },
        { name: "P(RL)", type: "Power", selected: false },
        { name: "V(vcc)", type: "Voltage", selected: false },
        { name: "V(n1)", type: "Voltage", selected: false },
        { name: "V(n2)", type: "Voltage", selected: false },
        { name: "V(n3)", type: "Voltage", selected: false },
        { name: "V(n4)", type: "Voltage", selected: false },
        { name: "V(oscin+)", type: "Voltage", selected: false },
        { name: "V(oscin-)", type: "Voltage", selected: false },
        { name: "freq", type: "Freq", selected: false },
        { name: "time", type: "Time", selected: false },
        { name: "I(Rfeedback)", type: "Current", selected: false },
        { name: "P(Rload)", type: "Power", selected: false },
    ];

    in property <bool> allow-custom-expressions: true;
    in property <bool> show-error: false;
    in property <string> filter-placeholder: "Filter expressions...";
    in property <string> custom-hint: "e.g. V(net1) / I(R1)";
    in-out property <string> filter-text: "";
    in-out property <string> custom-text: "";

    callback accepted;
    callback dismissed;
    callback expression-clicked(int);
    callback expression-right-clicked(int);
    callback filter-changed(string);
    callback custom-add;

    preferred-width: 600px;
    preferred-height: 560px;

    forward-focus: focus-scope;

    focus-scope := FocusScope {

        key-pressed(event) => {
            // dismiss the dialog on escape, but don't propagate the event to the parent
            if event.text == Key.Escape {
                root.dismissed();
                accept
            } 
            else {
                reject
            }
        }

        Rectangle {
            background: Palette.background;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: "Select one or more expressions to plot:";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                LineEdit {
                    height: 28px;
                    placeholder-text: root.filter-placeholder;
                    text <=> root.filter-text;
                    edited => { root.filter-changed(self.text); }
                }

                ExpressionGrid {
                    vertical-stretch: 1;
                    expressions: root.expressions;
                    expression-clicked(i) => { root.expression-clicked(i); }
                    expression-right-clicked(i) => { root.expression-right-clicked(i); }
                }

                if root.show-error: Text {
                    text: "Invalid expression";
                    font-size: 12px;
                    color: #ff3b30;
                }

                if root.allow-custom-expressions: HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Expression:";
                        font-size: 13px;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        placeholder-text: root.custom-hint;
                        height: 28px;
                        horizontal-stretch: 1;
                        text <=> root.custom-text;
                        accepted => { root.custom-add(); }
                    }

                    Button {
                        text: "Add";
                        clicked => { root.custom-add(); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                Legend {
                    items: [
                        { label: "Voltage", color: #5b9bd5 },
                        { label: "Current", color: #7cb342 },
                        { label: "Freq", color: #e57373 },
                        { label: "Time", color: #ba68c8 },
                        { label: "Power", color: #ffb74d },
                        { label: "Misc", color: #3a3d4a },
                    ];
                }
            }
        }
    }

    StandardButton { kind: cancel; clicked => { root.dismissed(); } }
    StandardButton { kind: ok; primary: true; clicked => { root.accepted(); } }
}
