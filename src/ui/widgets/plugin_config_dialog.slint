import { Button, LineEdit, Palette, StandardButton } from "std-widgets.slint";

export component PluginConfigDialog inherits Dialog {

    title: "Plugin Configuration";

    in-out property <string> xyce-path: "";
    in property <bool> show-error: false;
    in property <string> error-message: "";
    in property <bool> browse-enabled: true;

    callback accepted;
    callback dismissed;
    callback browse-clicked;
    callback path-edited(string);

    preferred-width: 540px;
    preferred-height: 200px;

    forward-focus: focus-scope;

    focus-scope := FocusScope {

        key-pressed(event) => {
            // dismiss the dialog on escape, but don't propagate the event to the parent
            if event.text == Key.Escape {
                root.dismissed();
                accept
            } 
            else {
                reject
            }
        }

        Rectangle {
            background: Palette.background;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;

                    Text {
                        text: "Xyce path:";
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.foreground;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        min-width: 80px;
                        overflow: TextOverflow.elide;
                    }

                    LineEdit {
                        horizontal-stretch: 1;
                        height: 28px;
                        text <=> root.xyce-path;
                        read-only: true;
                        enabled: root.browse-enabled;
                        edited => { root.path-edited(self.text); }
                        accepted => { root.path-edited(self.text); }
                    }

                    Button {
                        text: "Browse...";
                        clicked => { root.browse-clicked(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                if root.show-error: HorizontalLayout {
                    Text {
                        text: root.error-message;
                        font-size: 12px;
                        color: #cc0000;
                    }
                }
            }
        }
    }

    StandardButton { kind: cancel; clicked => { root.dismissed(); } }
    StandardButton { kind: ok; primary: true; clicked => { root.accepted(); } }
}