import { CheckBox, Palette, ScrollView, StandardButton } from "std-widgets.slint";

// one parameter combination offered by the step tool: step index, the
// parameter values, and selection
export struct StepItem {
    index: int,
    values: [string],
    selected: bool,
}

// column header row: checkbox spacer, step index, one column per sweep parameter.
// numeric columns share the available width and right-align header and cells so
// values scan by magnitude.
component StepHeader inherits HorizontalLayout {
    in property <[string]> keys;
    spacing: 0px;
    height: 30px;

    Rectangle {
        width: 36px;
        background: transparent;
    }

    Text {
        min-width: 60px;
        horizontal-stretch: 1;
        text: "Step";
        font-size: 13px;
        font-weight: 600;
        color: Palette.foreground.transparentize(0.25);
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    for key in root.keys: Text {
        min-width: 80px;
        horizontal-stretch: 2;
        text: key;
        font-size: 13px;
        font-weight: 600;
        color: Palette.foreground.transparentize(0.25);
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

// selectable step row: checkbox, step index, one cell per sweep parameter value.
// columns are aligned with the header by iterating over the same `keys` model and
// reading the matching value by index. the whole row is clickable and highlights
// on hover; odd rows carry a subtle stripe.
component StepRow inherits Rectangle {
    in property <StepItem> step-item;
    in property <[string]> keys;
    in property <bool> alternate;
    callback toggled;
    height: 32px;

    background: touch.has-hover ? Palette.alternate-background
        : root.alternate ? Palette.alternate-background.transparentize(0.55) : transparent;

    // declared first so the checkbox and cells stay on top of it
    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }

    HorizontalLayout {
        spacing: 0px;

        CheckBox {
            width: 36px;
            checked: root.step-item.selected;
            accessible-label: "Select step " + root.step-item.index;
            toggled => {
                root.toggled();
            }
        }

        Text {
            min-width: 60px;
            horizontal-stretch: 1;
            text: root.step-item.index;
            font-size: 13px;
            color: Palette.foreground;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        for value in root.step-item.values: Text {
            min-width: 80px;
            horizontal-stretch: 2;
            text: value;
            font-size: 13px;
            color: Palette.foreground;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// lightweight text-style action for bulk-selection helpers; keeps the visual
// weight on the dialog's primary actions (OK/Cancel), like macOS link buttons
component LinkButton inherits Rectangle {
    in property <string> label;
    callback clicked;
    height: 24px;
    width: label-text.preferred-width + 12px;
    border-radius: 5px;
    background: link-touch.has-hover ? Palette.alternate-background : transparent;

    label-text := Text {
        text: root.label;
        font-size: 13px;
        font-weight: 500;
        color: Palette.accent-background;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    link-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// step tool dialog: checkbox grid of parameter combinations. The selection is
// applied back to the chart on accept.
export component StepToolDialog inherits Dialog {
    title: "Step Tool";

    in-out property <[StepItem]> steps: [];
    in property <[string]> keys: [];
    in property <string> selection-count: "";

    callback accepted;
    callback dismissed;
    callback select-all;
    callback clear-all;
    callback invert-selection;
    callback step-toggled(int);

    preferred-width: 620px;
    // adapt to the content: chrome (~200px for title, toolbar, header, footer)
    // plus one row per step, capped so huge step lists scroll instead of growing
    preferred-height: min(root.grid-height + 200px, 640px);

    // height of the scrollable step grid: header row + one row per step
    private property <length> grid-height: 30px + root.steps.length * 32px + 8px;

    Rectangle {
        background: Palette.background;

        VerticalLayout {
            padding: 14px;
            spacing: 7px;

            Text {
                text: "Step Tool";
                font-size: 16px;
                font-weight: 700;
                color: Palette.foreground;
            }

            Text {
                text: "Select one or more parameter combinations to keep active for this chart";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.15);
            }

            StepHeader {
                keys: root.keys;
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                viewport-height: root.grid-height;
                VerticalLayout {
                    for step[index] in root.steps: StepRow {
                        step-item: step;
                        keys: root.keys;
                        alternate: index.mod(2) == 1;
                        toggled => { root.step-toggled(index); }
                    }
                }
            }

            // bulk-selection helpers trail the list so they stay reachable
            // without competing with the column headers
            HorizontalLayout {
                spacing: 8px;

                LinkButton {
                    label: "Select All";
                    clicked => { root.select-all(); }
                }

                LinkButton {
                    label: "Clear All";
                    clicked => { root.clear-all(); }
                }

                LinkButton {
                    label: "Invert";
                    clicked => { root.invert-selection(); }
                }

                // status, not an action: trail to the far edge of the row
                Text {
                    text: root.selection-count;
                    font-size: 12px;
                    color: Palette.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                }
            }
        }
    }

    StandardButton { kind: cancel; clicked => { root.dismissed(); } }
    StandardButton { kind: ok; primary: true; clicked => { root.accepted(); } }
}
