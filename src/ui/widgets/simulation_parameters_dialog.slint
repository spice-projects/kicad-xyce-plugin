                            noise-panel := NoiseParametersPanel {
                                // two-way bind each panel state property to the matching
                                // root property so the view adapter can read and write the
                                // noise analysis fields (sub-component state is not
                                // addressable from C++)
                                output-node <=> root.noise-output-node;
                                ref-node <=> root.noise-ref-node;
                                source-name <=> root.noise-source-name;
                                start-freq <=> root.noise-start-freq;
                                end-freq <=> root.noise-end-freq;
                                num-points <=> root.noise-num-points;
                                sweep-type-index <=> root.noise-sweep-type-index;
                                data-table <=> root.noise-data-table;
                                device-noise <=> root.noise-device-noise;
                                print-enabled <=> root.noise-print-enabled;
                                print-type-index <=> root.noise-print-type-index;
                                print-all-nodes <=> root.noise-print-all-nodes;
                                print-all-currents <=> root.noise-print-all-currents;
                                print-bjt-leads <=> root.noise-print-bjt-leads;
                                print-fet-leads <=> root.noise-print-fet-leads;
                                print-specific-variables <=> root.noise-print-specific-variables;
                                print-format-index <=> root.noise-print-format-index;
                                print-output-file <=> root.noise-print-output-file;
                                replace-ground <=> root.noise-replace-ground;
                            }
                        }

                        ScrollView {
                            visible: root.selected-tab == 5;
                            viewport-height: hb-panel.preferred-height;

                            hb-panel := HbParametersPanel {
                                // two-way bind each panel state property to the matching
                                // root property so the view adapter can read and write the
                                // harmonic balance fields (sub-component state is not
                                // addressable from C++)
                                frequencies <=> root.hb-frequencies;
                                harmonics <=> root.hb-harmonics;
                                tahb-index <=> root.hb-tahb-index;
                                selectharms-index <=> root.hb-selectharms-index;
                                startup-periods <=> root.hb-startup-periods;
                                nonlin-options <=> root.hb-nonlin-options;
                                linsol-options <=> root.hb-linsol-options;
                                print-enabled <=> root.hb-print-enabled;
                                print-type-index <=> root.hb-print-type-index;
                                print-all-nodes <=> root.hb-print-all-nodes;
                                print-all-currents <=> root.hb-print-all-currents;
                                print-specific-variables <=> root.hb-print-specific-variables;
                                print-format-index <=> root.hb-print-format-index;
                                print-output-file <=> root.hb-print-output-file;
                                replace-ground <=> root.hb-replace-ground;
                            }
                        }

                        ScrollView {
                            visible: root.selected-tab == 6;
                            viewport-height: lin-panel.preferred-height;

                            lin-panel := LinParametersPanel {
                                // two-way bind each panel state property to the matching
                                // root property so the view adapter can read and write the
                                // linear analysis fields (sub-component state is not
                                // addressable from C++)
                                sparcalc <=> root.lin-sparcalc;
                                format-index <=> root.lin-format-index;
                                lintype-index <=> root.lin-lintype-index;
                                dataformat-index <=> root.lin-dataformat-index;
                                file <=> root.lin-file;
                                output-width <=> root.lin-output-width;
                                precision <=> root.lin-precision;
                                sweep-mode-index <=> root.lin-sweep-mode-index;
                                points <=> root.lin-points;
                                start <=> root.lin-start;
                                end <=> root.lin-end;
                                data-table <=> root.lin-data-table;
                                print-enabled <=> root.lin-print-enabled;
                                print-type-index <=> root.lin-print-type-index;
                                print-all-nodes <=> root.lin-print-all-nodes;
                                print-all-currents <=> root.lin-print-all-currents;
                                print-power <=> root.lin-print-power;
                                print-bjt-leads <=> root.lin-print-bjt-leads;
                                print-fet-leads <=> root.lin-print-fet-leads;
                                print-specific-variables <=> root.lin-print-specific-variables;
                                print-format-index <=> root.lin-print-format-index;
                                print-output-file <=> root.lin-print-output-file;
                                replace-ground <=> root.lin-replace-ground;
                            }
                        }
                    }
                }

                // validation error label
                if root.show-error: Text {
                    text: root.error-message;
                    font-size: 12px;
                    color: #cc0000;
                }
            }
        }
    }

    StandardButton { kind: cancel; clicked => { root.dismissed(); } }
    StandardButton { kind: ok; primary: true; clicked => { root.accepted(); } }
}