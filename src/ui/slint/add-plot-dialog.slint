import { Button, LineEdit, ScrollView, Palette, StandardButton } from "std-widgets.slint";

// expression offered for plotting, mirrors the wx `ExpressionItem`
struct ExpressionItem {
    name: string,
    type: string,
    selected: bool,
}

// resolves a signal category to its color, matching the wx type palette
global TypePalette {
    public pure function color(type: string) -> color {
        if (type == "Voltage") { return #5b9bd5; }
        if (type == "Current") { return #7cb342; }
        if (type == "Freq") { return #e57373; }
        if (type == "Time") { return #ba68c8; }
        if (type == "Power") { return #ffb74d; }
        return #3a3d4a;
    }
}

// small filled dot marking the chip signal type
component TypeDot inherits Rectangle {
    in property <color> dot-color;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: dot-color;
}

// selectable expression tile: colored identity dot, ellipsized name, accent when
// picked. State transitions are animated for a native, non-janky feel.
component ExpressionChip inherits Rectangle {
    in property <string> label;
    in property <color> dot-color;
    in property <bool> selected: false;
    callback clicked;

    height: 32px;
    border-radius: 8px;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Palette.accent-background : (touch.has-hover ? Palette.accent-background : Palette.border);
    background: root.selected ? Palette.accent-background : (touch.has-hover ? Palette.control-background : Palette.alternate-background);

    animate background, border-color, border-width {
        duration: 140ms;
        easing: ease-out;
    }

    HorizontalLayout {
        alignment: start;
        padding-left: 10px;
        padding-right: 8px;
        spacing: 7px;

        VerticalLayout {
            width: 8px;
            alignment: center;
            TypeDot {
                dot-color: root.dot-color;
                opacity: root.selected ? 0.9 : 1;
            }
        }

        Text {
            text: root.label;
            color: root.selected ? Palette.accent-foreground : Palette.foreground;
            font-size: 13px;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            width: 16px;
            visible: root.selected;
            alignment: center;
            Text {
                text: "✓";
                color: Palette.accent-foreground;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// flow of chips inside a scrollable region; columns reflow with the dialog width
component ExpressionGrid inherits ScrollView {
    in property <[ExpressionItem]> expressions;
    callback expression-clicked(int);

    private property <length> gap: 8px;
    private property <int> columns: max(1, Math.round(self.width / 190px));
    private property <length> cell-width: (self.visible-width - (self.columns - 1) * self.gap - 8px) / self.columns;
    private property <length> row-height: 32px;
    private property <int> row-count: Math.ceil(self.expressions.length / self.columns);
    private property <length> content-height: self.row-count * (self.row-height + self.gap);

    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

    viewport-width: self.visible-width;
    viewport-height: self.content-height + 8px;

    for exp[index] in root.expressions: ExpressionChip {
        x: 4px + Math.mod(index, root.columns) * (root.cell-width + root.gap);
        y: 4px + Math.floor(index / root.columns) * (root.row-height + root.gap);
        width: root.cell-width;
        height: root.row-height;
        label: exp.name;
        dot-color: TypePalette.color(exp.type);
        selected: exp.selected;
        clicked => {
            root.expression-clicked(index);
        }
    }
}

// bottom legend of the signal categories
struct LegendItem {
    label: string,
    color: color,
}

component Legend inherits HorizontalLayout {
    in property <[LegendItem]> items;

    for item in root.items: HorizontalLayout {
        spacing: 4px;
        TypeDot {
            dot-color: item.color;
        }

        Text {
            text: item.label;
            font-size: 11px;
            color: Palette.foreground.transparentize(0.35);
            vertical-alignment: center;
        }
    }
}

// macOS-style additive-plot picker: filter, chip grid, optional custom
// expression entry, legend, and standard OK/Cancel actions.
export component AddPlotDialog inherits Dialog {
    title: "Select Plot Expressions";

    in-out property <[ExpressionItem]> expressions: [
        { name: "V(out)", type: "Voltage", selected: true },
        { name: "V(in)", type: "Voltage", selected: true },
        { name: "V(fb)", type: "Voltage", selected: false },
        { name: "I(R1)", type: "Current", selected: false },
        { name: "I(C1)", type: "Current", selected: false },
        { name: "I(L1)", type: "Current", selected: false },
        { name: "P(RL)", type: "Power", selected: false },
        { name: "V(vcc)", type: "Voltage", selected: false },
        { name: "V(n1)", type: "Voltage", selected: false },
        { name: "V(n2)", type: "Voltage", selected: false },
        { name: "V(n3)", type: "Voltage", selected: false },
        { name: "V(n4)", type: "Voltage", selected: false },
        { name: "V(oscin+)", type: "Voltage", selected: false },
        { name: "V(oscin-)", type: "Voltage", selected: false },
        { name: "freq", type: "Freq", selected: false },
        { name: "time", type: "Time", selected: false },
        { name: "I(Rfeedback)", type: "Current", selected: false },
        { name: "P(Rload)", type: "Power", selected: false },
    ];

    in property <bool> allow-custom-expressions: true;
    in property <bool> show-error: false;
    in property <string> filter-placeholder: "Filter expressions...";
    in property <string> custom-hint: "e.g. V(net1) / I(R1)";
    in-out property <string> filter-text: "";
    in-out property <string> custom-text: "";

    callback accepted;
    callback dismissed;
    callback expression-clicked(int);
    callback filter-changed(string);
    callback custom-add;

    preferred-width: 600px;
    preferred-height: 560px;

    Rectangle {
        background: Palette.background;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            Text {
                text: "Select one or more expressions to plot:";
                font-size: 13px;
                font-weight: 600;
                color: Palette.foreground;
            }

            LineEdit {
                height: 30px;
                placeholder-text: root.filter-placeholder;
                text <=> root.filter-text;
                edited => { root.filter-changed(self.text); }
            }

            ExpressionGrid {
                vertical-stretch: 1;
                expressions: root.expressions;
                expression-clicked(i) => { root.expression-clicked(i); }
            }

            if root.show-error: Text {
                text: "Invalid expression";
                font-size: 12px;
                color: #ff3b30;
            }

            if root.allow-custom-expressions: HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "Expression:";
                    font-size: 13px;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }

                LineEdit {
                    placeholder-text: root.custom-hint;
                    height: 30px;
                    horizontal-stretch: 1;
                    text <=> root.custom-text;
                    accepted => { root.custom-add(); }
                }

                Button {
                    text: "Add";
                    clicked => { root.custom-add(); }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            Legend {
                items: [
                    { label: "Voltage", color: #5b9bd5 },
                    { label: "Current", color: #7cb342 },
                    { label: "Freq", color: #e57373 },
                    { label: "Time", color: #ba68c8 },
                    { label: "Power", color: #ffb74d },
                    { label: "Misc", color: #3a3d4a },
                ];
            }
        }
    }

    StandardButton { kind: cancel; clicked => { root.dismissed(); } }
    StandardButton { kind: ok; primary: true; clicked => { root.accepted(); } }
}
