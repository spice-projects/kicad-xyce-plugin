// inline add-plot expression selection panel rendered as a modal overlay
// within the main window. inherits the common modal panel chrome (title bar,
// close button, dimmed backdrop, OK/Cancel footer) from ModalPanel; only the
// expression selector content and panel-specific properties/callbacks are
// defined here.
import { Button, LineEdit, Palette } from "std-widgets.slint";
import {
    ExpressionItem,
    ExpressionGrid,
    Legend,
} from "../components/expression_selector.slint";
import { ModalPanel } from "../components/modal_panel.slint";

export component AddPlotPanel inherits ModalPanel {

    title: "Select Plot Expressions";
    card-width: 600px;
    card-height: 560px;

    in property <[ExpressionItem]> expressions: [];
    in property <bool> allow-custom-expressions: true;
    in-out property <string> filter-text: "";
    in-out property <string> custom-text: "";

    callback expression-clicked(int);
    callback expression-right-clicked(int);
    callback filter-changed(string);
    callback custom-add();

    // expression selection instruction
    Text {
        text: "Select one or more expressions to plot:";
        font-size: 13px;
        font-weight: 600;
        color: Palette.foreground;
    }

    // filter input — drives the expression grid below via a callback
    LineEdit {
        height: 28px;
        placeholder-text: "Filter expressions...";
        text <=> root.filter-text;
        edited => { root.filter-changed(self.text); }
    }

    // expression chip grid — model-driven from the renderer
    ExpressionGrid {
        vertical-stretch: 1;
        expressions: root.expressions;
        expression-clicked(i) => { root.expression-clicked(i); }
        expression-right-clicked(i) => { root.expression-right-clicked(i); }
    }

    // optional custom expression entry row
    if root.allow-custom-expressions: HorizontalLayout {
        spacing: 8px;

        Text {
            text: "Expression:";
            font-size: 13px;
            color: Palette.foreground;
            vertical-alignment: center;
        }

        LineEdit {
            placeholder-text: "e.g. V(net1) / I(R1)";
            height: 28px;
            horizontal-stretch: 1;
            text <=> root.custom-text;
            accepted => { root.custom-add(); }
        }

        Button {
            text: "Add";
            clicked => { root.custom-add(); }
        }
    }

    // separator before the legend
    Rectangle {
        height: 1px;
        background: Palette.border;
    }

    // signal type legend
    Legend {
        items: [
            { label: "Voltage", color: #5b9bd5 },
            { label: "Current", color: #7cb342 },
            { label: "Freq", color: #e57373 },
            { label: "Time", color: #ba68c8 },
            { label: "Power", color: #ffb74d },
            { label: "Misc", color: #3a3d4a },
        ];
    }
}
