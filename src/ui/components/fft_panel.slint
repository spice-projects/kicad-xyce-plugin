// inline FFT setup panel rendered as a modal overlay within the main window.
// inherits the common modal panel chrome (title bar, close button, dimmed
// backdrop, OK/Cancel footer) from ModalPanel; only the FFT setup content and
// panel-specific properties/callbacks are defined here.
import {
    CheckBox,
    ComboBox,
    LineEdit,
    RadioGroup,
    Palette,
} from "std-widgets.slint";
import {
    ExpressionItem,
    ExpressionGrid,
    Legend,
} from "../components/expression_selector.slint";
import { ModalPanel } from "../components/modal_panel.slint";

export component FftPanel inherits ModalPanel {

    title: "FFT";
    card-width: 600px;
    card-height: 600px;

    // panel-specific properties forwarded from MainWindow
    in-out property <int> range-mode: 0;
    in-out property <string> custom-from: "";
    in-out property <string> custom-to: "";
    in-out property <int> window-index: 2;
    in-out property <int> format-index: 0;
    in-out property <int> output-index: 0;
    in-out property <bool> keep-dc: true;
    in-out property <int> np-index: 2;
    in-out property <string> custom-np: "";
    in property <[ExpressionItem]> expressions: [];
    in-out property <string> filter-text: "";

    // forwarded from the panel to MainWindow for the view adapter
    callback expression-clicked(int);
    callback filter-changed(string);

    function range-index(label: string) -> int {
        if label == "Current Zoom" { return 1; }
        if label == "Custom" { return 2; }
        return 0;
    }

    Text {
        text: "Select expressions and FFT parameters:";
        font-size: 13px;
        font-weight: 600;
        color: Palette.foreground;
    }

    LineEdit {
        height: 28px;
        placeholder-text: "Filter expressions...";
        text <=> root.filter-text;
        edited => { root.filter-changed(self.text); }
    }

    ExpressionGrid {
        vertical-stretch: 1;
        expressions: root.expressions;
        expression-clicked(i) => { root.expression-clicked(i); }
    }

    Rectangle {
        height: 1px;
        background: Palette.border;
    }

    Legend {
        items: [
            { label: "Voltage", color: #5b9bd5 },
            { label: "Current", color: #7cb342 },
            { label: "Freq", color: #e57373 },
            { label: "Time", color: #ba68c8 },
            { label: "Power", color: #ffb74d },
            { label: "Misc", color: #3a3d4a },
        ];
    }

    HorizontalLayout {
        spacing: 10px;

        Text {
            width: 120px;
            text: "Data Range:";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        RadioGroup {
            orientation: Orientation.horizontal;
            RadioButton {
                text: "All";
                checked: root.range-mode == 0;
                toggled => { root.range-mode = 0; }
            }

            RadioButton {
                text: "Current Zoom";
                checked: root.range-mode == 1;
                toggled => { root.range-mode = 1; }
            }

            RadioButton {
                text: "Custom";
                checked: root.range-mode == 2;
                toggled => { root.range-mode = 2; }
            }
        }

        LineEdit {
            width: 84px;
            height: 28px;
            placeholder-text: "from";
            text <=> root.custom-from;
            enabled: root.range-mode == 2;
        }

        LineEdit {
            width: 84px;
            height: 28px;
            placeholder-text: "to";
            text <=> root.custom-to;
            enabled: root.range-mode == 2;
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: LayoutAlignment.start;

        Text {
            width: 120px;
            text: "Window:";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        ComboBox {
            height: 28px;
            model: ["Rectangular", "Hamming", "Hanning", "Blackman"];
            current-index <=> root.window-index;
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: LayoutAlignment.start;

        Text {
            width: 120px;
            text: "Format:";
            font-size: 12px;
            font-weight: 600;
            color: Palette.foreground.transparentize(0.15);
            vertical-alignment: center;
        }

        ComboBox {
            height: 28px;
            model: ["Normalized (NORM)", "Unnormalized (UNORM)"];
            current-index <=> root.format-index;
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: LayoutAlignment.start;

        Text {
            width: 120px;
            text: "Output:";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        ComboBox {
            height: 28px;
            model: ["Magnitude", "Magnitude (dB)", "Phase"];
            current-index <=> root.output-index;
        }

        CheckBox {
            text: "Keep DC";
            checked <=> root.keep-dc;
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: LayoutAlignment.start;

        Text {
            width: 120px;
            text: "FFT Points (NP):";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        ComboBox {
            height: 28px;
            model: ["256", "512", "1024", "2048", "4096", "8192", "16384", "Custom..."];
            current-index <=> root.np-index;
        }

        LineEdit {
            width: 120px;
            height: 28px;
            placeholder-text: "e.g. 4096";
            text <=> root.custom-np;
            enabled: root.np-index == 7;
        }
    }
}
