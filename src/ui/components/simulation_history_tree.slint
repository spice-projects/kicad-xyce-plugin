import { Palette, ScrollView } from "std-widgets.slint";

export struct SimulationHistoryFile {
    name: string,
    type: string,
}

export struct SimulationHistoryRun {
    timestamp: string,
    display: string,
    files: [SimulationHistoryFile],
}

// accent color for a file type dot
component TypeDot inherits Rectangle {
    in property <string> file-type;
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: root.file-type == "raw" ? #3b82f6 : root.file-type == "fft" ? #8b5cf6 : root.file-type == "out" ? #e0a03c : #8e8e93;
}

// chevron triangle pointing right (collapsed) or down (expanded)
component Chevron inherits Path {
    in property <bool> expanded;
    width: 8px;
    height: 8px;
    fill: Palette.foreground.with-alpha(0.45);
    commands: root.expanded ? "M 0 1 L 8 1 L 4 6.5 Z" : "M 1 0 L 7 4 L 1 8 Z";
}

// one file row inside a run block
component FileRow inherits Rectangle {
    in property <SimulationHistoryFile> file;
    in property <string> timestamp;
    in property <bool> selected;
    callback file-selected(string, string);

    height: 24px;

    // hover and selection feedback, click target for the whole row
    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.file-selected(root.timestamp, root.file.name); }

        Rectangle {
            x: 6px;
            width: parent.width - 12px;
            height: 100%;
            border-radius: 4px;
            background: root.selected ? Palette.foreground.transparentize(0.9) : ta.has-hover ? Palette.foreground.transparentize(0.95) : transparent;
            animate background {
                duration: 100ms;
                easing: ease-out;
            }
        }
    }

    // type dot, vertically centered
    TypeDot {
        x: 24px;
        y: (parent.height - self.height) / 2;
        file-type: root.file.type;
    }

    // file name, vertically centered, elided when too long
    Text {
        x: 40px;
        width: parent.width - 40px - 46px;
        height: 100%;
        text: root.file.name;
        font-size: 11px;
        color: Palette.foreground;
        vertical-alignment: center;
        overflow: TextOverflow.elide;
    }

    // open affordance, only visible on hover
    Text {
        x: parent.width - 44px;
        width: 34px;
        height: 100%;
        text: "Open";
        font-size: 10px;
        color: Palette.foreground.with-alpha(0.55);
        vertical-alignment: center;
        horizontal-alignment: right;
        visible: ta.has-hover;
    }
}

export component SimulationHistoryTree inherits Rectangle {
    in property <[SimulationHistoryRun]> runs: [];
    callback file-selected(timestamp: string, file_name: string);

    // last file the user opened, drives the row highlight
    in-out property <string> selected-timestamp;
    in-out property <string> selected-file;

    background: Palette.background;

    VerticalLayout {
        // panel header with title and hairline separator
        Rectangle {
            height: 30px;

            Text {
                x: 10px;
                width: parent.width - 20px;
                height: 100%;
                text: "Simulation History";
                font-size: 11px;
                font-weight: 600;
                color: Palette.foreground.with-alpha(0.55);
                vertical-alignment: center;
            }

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Palette.border.transparentize(0.4);
            }
        }

        // scrollable run list
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0px;
                padding: 4px;

                // one collapsible block per run, the expanded state lives on
                // this per-run instance so no model changes are needed
                for run in root.runs: run-item := VerticalLayout {
                    private property <bool> expanded: true;
                    spacing: 0px;

                    // run header row, toggles the expanded state
                    Rectangle {
                        height: 26px;

                        header-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { run-item.expanded = !run-item.expanded; }

                            Rectangle {
                                x: 4px;
                                width: parent.width - 8px;
                                height: 100%;
                                border-radius: 4px;
                                background: header-ta.has-hover ? Palette.foreground.transparentize(0.96) : transparent;
                                animate background {
                                    duration: 100ms;
                                    easing: ease-out;
                                }
                            }
                        }

                        Chevron {
                            x: 14px;
                            y: (parent.height - self.height) / 2;
                            expanded: run-item.expanded;
                        }

                        // formatted timestamp of the run
                        Text {
                            x: 28px;
                            height: 100%;
                            text: run.display;
                            font-size: 11px;
                            font-weight: 600;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }

                        // file count of this run, right aligned
                        Text {
                            x: parent.width - 70px;
                            width: 60px;
                            height: 100%;
                            text: run.files.length + (run.files.length == 1 ? " file" : " files");
                            font-size: 10px;
                            color: Palette.foreground.with-alpha(0.4);
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }

                    // file rows of this run, shown when expanded
                    if run-item.expanded: VerticalLayout {
                        spacing: 0px;
                        for file in run.files: FileRow {
                            file: file;
                            timestamp: run.timestamp;
                            selected: root.selected-timestamp == run.timestamp && root.selected-file == file.name;
                            file-selected(t, f) => {
                                root.selected-timestamp = t;
                                root.selected-file = f;
                                root.file-selected(t, f);
                            }
                        }
                    }

                    // gap between run blocks
                    Rectangle {
                        height: 6px;
                    }
                }

                // empty state when no runs are recorded
                if root.runs.length == 0: Rectangle {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;

                    Text {
                        text: "No simulation history";
                        font-size: 11px;
                        color: Palette.foreground.with-alpha(0.5);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }
}
