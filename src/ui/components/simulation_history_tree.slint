import { Palette, Button, ScrollView } from "std-widgets.slint";

export struct SimulationHistoryFile {
    name: string,
    type: string,
}

export struct SimulationHistoryRun {
    timestamp: string,
    files: [SimulationHistoryFile],
}

export global SimulationHistoryTreeActions {
    callback file-selected(timestamp: string, file_name: string);
    callback run-selected(timestamp: string);
}

export component SimulationHistoryTree inherits Rectangle {
    in property <[SimulationHistoryRun]> runs: [];

    callback file-selected(timestamp: string, file_name: string);
    callback run-selected(timestamp: string);
    background: Palette.background;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            spacing: 4px;
            padding: 4px;

            for run[index] in root.runs: run-block := VerticalLayout {
                spacing: 2px;
                padding-top: 4px;
                padding-bottom: 4px;

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                TouchArea {
                    height: 22px;
                    clicked => { root.run-selected(run.timestamp); }

                    Text {
                        text: run.timestamp;
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.foreground;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                for file[index] in run.files: file-row := HorizontalLayout {
                    spacing: 6px;
                    padding-left: 12px;

                    Text {
                        text: file.type;
                        font-size: 11px;
                        color: Palette.foreground.with-alpha(0.7);
                        min-width: 40px;
                    }

                    Text {
                        text: file.name;
                        font-size: 11px;
                        color: Palette.foreground;
                        horizontal-stretch: 1;
                        overflow: TextOverflow.elide;
                    }

                    Button {
                        text: "Open";
                        clicked => { root.file-selected(run.timestamp, file.name); }
                    }
                }
            }

            if root.runs.length == 0: empty-state := Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                height: 60px;

                Text {
                    text: "No simulation history";
                    font-size: 12px;
                    color: Palette.foreground.with-alpha(0.6);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
}
