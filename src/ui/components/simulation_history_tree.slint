import { Palette, ScrollView } from "std-widgets.slint";

export struct SimulationHistoryFile {
    name: string,
    type: string,
}

export struct SimulationHistoryRun {
    timestamp: string,
    display: string,
    files: [SimulationHistoryFile],
}

// styled file type badge tag (RAW, FFT, LOG, etc.)
component FileTypeBadge inherits Rectangle {
    in property <string> file-type;
    in property <bool> selected: false;

    width: 32px;
    height: 16px;
    border-radius: 4px;

    background: root.selected
        ? Palette.accent-foreground.with-alpha(0.2)
        : root.file-type == "raw"
        ? #3b82f6.with-alpha(0.15)
        : root.file-type == "fft"
        ? #8b5cf6.with-alpha(0.15)
        : root.file-type == "out"
        ? #f59e0b.with-alpha(0.15)
        : Palette.foreground.with-alpha(0.08);

    border-width: 1px;
    border-color: root.selected
        ? Palette.accent-foreground.with-alpha(0.35)
        : root.file-type == "raw"
        ? #3b82f6.with-alpha(0.3)
        : root.file-type == "fft"
        ? #8b5cf6.with-alpha(0.3)
        : root.file-type == "out"
        ? #f59e0b.with-alpha(0.3)
        : Palette.border.with-alpha(0.3);

    Text {
        text: root.file-type == "raw" ? "RAW" : root.file-type == "fft" ? "FFT" : root.file-type == "out" ? "LOG" : root.file-type;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.2px;
        color: root.selected
            ? Palette.accent-foreground
            : root.file-type == "raw"
            ? #2563eb
            : root.file-type == "fft"
            ? #7c3aed
            : root.file-type == "out"
            ? #d97706
            : Palette.foreground.with-alpha(0.7);
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// chevron indicator pointing right (collapsed) or down (expanded)
component Chevron inherits Rectangle {
    in property <bool> expanded;
    width: 12px;
    height: 12px;

    Path {
        width: 8px;
        height: 8px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: Palette.foreground.with-alpha(0.55);
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: root.expanded ? "M 1.5 2.5 L 4 5 L 6.5 2.5" : "M 2.5 1.5 L 5 4 L 2.5 6.5";
    }
}

// one file row inside a run block
component FileRow inherits Rectangle {
    in property <SimulationHistoryFile> file;
    in property <string> timestamp;
    in property <bool> selected;
    callback file-selected(string, string);

    height: 28px;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.file-selected(root.timestamp, root.file.name); }

        Rectangle {
            x: 4px;
            width: parent.width - 8px;
            height: 100%;
            border-radius: 6px;
            background: root.selected
                ? Palette.accent-background
                : ta.pressed
                ? Palette.foreground.transparentize(0.88)
                : ta.has-hover
                ? Palette.foreground.transparentize(0.94)
                : transparent;
            animate background {
                duration: 100ms;
                easing: ease-out;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                cross-axis-alignment: center;

                FileTypeBadge {
                    file-type: root.file.type;
                    selected: root.selected;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.file.name;
                    font-size: 11px;
                    font-weight: root.selected ? 600 : 400;
                    color: root.selected ? Palette.accent-foreground : Palette.foreground;
                    vertical-alignment: center;
                    overflow: TextOverflow.elide;
                }

                if root.selected: Text {
                    text: "✓";
                    font-size: 11px;
                    font-weight: 700;
                    color: Palette.accent-foreground;
                    vertical-alignment: center;
                }

                if !root.selected && ta.has-hover: Text {
                    text: "Open →";
                    font-size: 10px;
                    font-weight: 600;
                    color: Palette.accent-background;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component SimulationHistoryTree inherits Rectangle {
    in property <[SimulationHistoryRun]> runs: [];
    callback file-selected(timestamp: string, file_name: string);

    // last file the user opened, drives the row highlight
    in-out property <string> selected-timestamp;
    in-out property <string> selected-file;

    background: Palette.background;

    // right border separating the sidebar from the rest of the workspace
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Palette.border;
    }

    VerticalLayout {
        // panel header with title, run count badge, and separator
        Rectangle {
            height: 36px;
            background: Palette.background;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                cross-axis-alignment: center;
                spacing: 8px;

                Text {
                    text: "Simulation History";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.runs.length > 0: Rectangle {
                    height: 18px;
                    border-radius: 9px;
                    background: Palette.foreground.with-alpha(0.08);

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        cross-axis-alignment: center;

                        Text {
                            text: "\{root.runs.length} " + (root.runs.length == 1 ? "run" : "runs");
                            font-size: 10px;
                            font-weight: 600;
                            color: Palette.foreground.with-alpha(0.65);
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Palette.border;
            }
        }

        // scrollable run list
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 6px;
                padding: 6px;

                // one collapsible block per run
                for run in root.runs: run-item := VerticalLayout {
                    private property <bool> expanded: true;
                    spacing: 4px;

                    // run card header
                    Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.border.with-alpha(0.35);
                        background: header-ta.pressed
                            ? Palette.foreground.transparentize(0.88)
                            : header-ta.has-hover
                            ? Palette.foreground.transparentize(0.93)
                            : Palette.control-background.with-alpha(0.5);

                        animate background, border-color {
                            duration: 100ms;
                            easing: ease-out;
                        }

                        header-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { run-item.expanded = !run-item.expanded; }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                cross-axis-alignment: center;

                                Chevron {
                                    expanded: run-item.expanded;
                                }

                                // timestamp of the run
                                Text {
                                    horizontal-stretch: 1;
                                    text: run.display;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                    vertical-alignment: center;
                                    overflow: TextOverflow.elide;
                                }

                                // file count pill badge
                                Rectangle {
                                    height: 16px;
                                    border-radius: 8px;
                                    background: Palette.foreground.with-alpha(0.08);

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: run.files.length + (run.files.length == 1 ? " file" : " files");
                                            font-size: 9px;
                                            font-weight: 500;
                                            color: Palette.foreground.with-alpha(0.6);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // file rows with hierarchy guide line when expanded
                    if run-item.expanded: Rectangle {
                        // vertical guide line on the left
                        Rectangle {
                            x: 14px;
                            y: 2px;
                            width: 1.5px;
                            height: parent.height - 4px;
                            border-radius: 0.75px;
                            background: Palette.border.with-alpha(0.4);
                        }

                        VerticalLayout {
                            padding-left: 16px;
                            spacing: 2px;

                            for file in run.files: FileRow {
                                file: file;
                                timestamp: run.timestamp;
                                selected: root.selected-timestamp == run.timestamp && root.selected-file == file.name;
                                file-selected(t, f) => {
                                    root.selected-timestamp = t;
                                    root.selected-file = f;
                                    root.file-selected(t, f);
                                }
                            }
                        }
                    }
                }

                // empty state when no runs are recorded
                if root.runs.length == 0: Rectangle {
                    vertical-stretch: 1;
                    min-height: 160px;

                    VerticalLayout {
                        alignment: center;
                        padding: 20px;
                        spacing: 8px;

                        // history clock icon
                        Path {
                            width: 24px;
                            height: 24px;
                            stroke: Palette.foreground.with-alpha(0.3);
                            stroke-width: 1.5px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 12 2 A 10 10 0 1 0 22 12 A 10 10 0 1 0 12 2 M 12 6 L 12 12 L 16 14";
                        }

                        Text {
                            text: "No Simulation History";
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.foreground.with-alpha(0.65);
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Previous runs and generated files will appear here.";
                            font-size: 11px;
                            color: Palette.foreground.with-alpha(0.4);
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
