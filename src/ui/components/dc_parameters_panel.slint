import { CheckBox, ComboBox, LineEdit, Palette, TextEdit } from "std-widgets.slint";

export component DcParametersPanel inherits Rectangle {

    // --- sweep configuration ---
    // 0 = LIN, 1 = DEC, 2 = OCT, 3 = LIST, 4 = DATA
    in-out property <int> sweep-mode-index: 0;
    in-out property <string> primary-variable: "";
    in-out property <string> start: "";
    in-out property <string> stop: "";
    in-out property <string> step: "";
    in-out property <string> points: "";
    in-out property <string> list-values: "";
    in-out property <string> data-table: "";
    in-out property <string> secondary-variable: "";
    in-out property <string> secondary-start: "";
    in-out property <string> secondary-stop: "";
    in-out property <string> secondary-step: "";
    in-out property <string> secondary-points: "";

    // --- .MEASURE directives ---
    in-out property <string> measure: "";

    // --- .PRINT section ---
    in-out property <bool> print-enabled: false;
    // 0 = DC, 1 = HOMOTOPY
    in-out property <int> print-type-index: 0;
    in-out property <bool> print-all-nodes: false;
    in-out property <bool> print-all-currents: false;
    in-out property <bool> print-power: false;
    in-out property <bool> print-bjt-leads: false;
    in-out property <bool> print-fet-leads: false;
    in-out property <string> print-specific-variables: "";
    in-out property <int> print-format-index: 0;
    in-out property <string> print-output-file: "";

    // --- global settings (replace ground) ---
    in-out property <bool> replace-ground: true;

    // card look: bordered, rounded, on the control background
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;

    VerticalLayout {

        padding: 16px;
        spacing: 14px;

        // card header
        Text {
            text: "DC Sweep (.DC)";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            overflow: elide;
        }

        // ---- .PRINT section ----
        print-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                CheckBox {
                    text: "Enable .PRINT output";
                    font-weight: 600;
                    checked <=> root.print-enabled;
                }

                if root.print-enabled: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    // print type selector (DC / HOMOTOPY)
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Print type";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                        ComboBox {
                            height: 28px;
                            model: ["DC", "HOMOTOPY"];
                            current-index <=> root.print-type-index;
                        }
                    }

                    // wildcard voltage/current/power and lead rows
                    HorizontalLayout {
                        spacing: 16px;
                        CheckBox { text: "All voltages V(*)"; checked <=> root.print-all-nodes; }
                        CheckBox { text: "All currents I(*)"; checked <=> root.print-all-currents; }
                        CheckBox { text: "Power P(*)"; checked <=> root.print-power; }
                        CheckBox { text: "BJT leads"; checked <=> root.print-bjt-leads; }
                        CheckBox { text: "FET leads"; checked <=> root.print-fet-leads; }
                    }

                    // additional variables
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Additional variables";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. V(out) V(in)";
                            text <=> root.print-specific-variables;
                        }
                    }

                    // format combo
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                        ComboBox {
                            height: 28px;
                            model: ["(default)", "STD", "NOINDEX", "PROBE", "TECPLOT", "RAW", "CSV", "GNUPLOT", "SPLOT"];
                            current-index <=> root.print-format-index;
                        }
                    }

                    // output file
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Output file";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                        LineEdit {
                            height: 28px;
                            placeholder-text: "optional output file path";
                            text <=> root.print-output-file;
                        }
                    }
                }
            }
        }

        // ---- sweep configuration ----
        sweep-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                // sweep mode selector
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Sweep mode";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    ComboBox {
                        height: 28px;
                        model: ["LIN", "DEC", "OCT", "LIST", "DATA"];
                        current-index <=> root.sweep-mode-index;
                        selected(current-value) => {
                            // carry the numeric value between the step and points
                            // fields when switching modes (matches the wx panel)
                            if current-value == "LIN" {
                                if root.step == "" && root.points != "" { root.step = root.points; }
                                if root.secondary-step == "" && root.secondary-points != "" { root.secondary-step = root.secondary-points; }
                            } else if current-value == "DEC" || current-value == "OCT" {
                                if root.points == "" && root.step != "" { root.points = root.step; }
                                if root.secondary-points == "" && root.secondary-step != "" { root.secondary-points = root.secondary-step; }
                            }
                        }
                    }
                }

                // primary sweep section
                Text {
                    text: "Primary sweep";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Primary variable";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "e.g. V1";
                        text <=> root.primary-variable;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Start";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "start value (e.g. 0)";
                        text <=> root.start;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Stop";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "stop value (e.g. 5)";
                        text <=> root.stop;
                    }
                }

                // step size for LIN sweeps
                if root.sweep-mode-index == 0: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Step";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "step size (e.g. 0.1)";
                        text <=> root.step;
                    }
                }

                // points for DEC/OCT log sweeps
                if root.sweep-mode-index == 1 || root.sweep-mode-index == 2: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Points";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "points per decade/octave";
                        text <=> root.points;
                    }
                }

                // explicit list of values for LIST sweeps
                if root.sweep-mode-index == 3: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "List values";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "space-separated values (e.g. 0 1 2 5)";
                        text <=> root.list-values;
                    }
                }

                // data table name for DATA sweeps
                if root.sweep-mode-index == 4: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Data table";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "name of the data block to sweep";
                        text <=> root.data-table;
                    }
                }

                // secondary sweep section
                Text {
                    text: "Secondary sweep";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Secondary variable";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "e.g. V2";
                        text <=> root.secondary-variable;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Secondary start";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "secondary start value";
                        text <=> root.secondary-start;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Secondary stop";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "secondary stop value";
                        text <=> root.secondary-stop;
                    }
                }

                // secondary step size for LIN sweeps
                if root.sweep-mode-index == 0: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Secondary step";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "secondary step size";
                        text <=> root.secondary-step;
                    }
                }

                // secondary points for DEC/OCT log sweeps
                if root.sweep-mode-index == 1 || root.sweep-mode-index == 2: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Secondary points";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    LineEdit {
                        height: 28px;
                        placeholder-text: "secondary points per decade/octave";
                        text <=> root.secondary-points;
                    }
                }
            }
        }

        // ---- .MEASURE directives ----
        measure-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 6px;

                Text {
                    text: ".MEASURE directives (one per line)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                TextEdit {
                    min-height: 60px;
                    wrap: word-wrap;
                    placeholder-text: "e.g. .MEASURE DC vout_max MAX V(out)";
                    text <=> root.measure;
                }
            }
        }

        // ---- global settings ----
        global-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                CheckBox {
                    text: "Replace ground (GND) with 0";
                    checked <=> root.replace-ground;
                }

                Text {
                    text: "When enabled, all ground (GND) references in the netlist are replaced with the node name '0' before simulation. This is required by Xyce which uses '0' as the global ground node.";
                    font-size: 12px;
                    font-italic: true;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}