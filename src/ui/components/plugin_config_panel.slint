// plugin configuration panel rendered inline as a modal overlay within the main
// window, avoiding a separate OS window (which Slint dialogs create by default).
// a dimmed backdrop absorbs pointer events so the underlying content is
// inaccessible, and a centered card holds the form — together they emulate
// modality without the modal_manager native-window hacks.
import { Button, LineEdit, Palette, StandardButton } from "std-widgets.slint";

export component PluginConfigPanel inherits Rectangle {

    in-out property <string> xyce-path: "";
    in property <bool> show-error: false;
    in property <string> error-message: "";
    in property <bool> browse-enabled: true;

    callback accepted;
    callback dismissed;
    callback browse-clicked;
    callback path-edited(string);

    // full-size dimmed backdrop: covers the parent area, dims the content
    // underneath, and absorbs every pointer event so the panel feels modal
    background: Palette.background.transparentize(0.65);

    // centered card holding the form content
    FocusScope {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 540px;
        height: 200px;

        // grab focus on init so Escape is captured without a parent click
        init => { self.focus(); }

        key-pressed(event) => {
            // dismiss on escape, do not propagate to the parent
            if event.text == Key.Escape {
                root.dismissed();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: Palette.background;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;

                    Text {
                        text: "Xyce path:";
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.foreground;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        min-width: 80px;
                        overflow: TextOverflow.elide;
                    }

                    LineEdit {
                        horizontal-stretch: 1;
                        height: 28px;
                        text <=> root.xyce-path;
                        read-only: true;
                        enabled: root.browse-enabled;
                        edited => { root.path-edited(self.text); }
                        accepted => { root.path-edited(self.text); }
                    }

                    Button {
                        text: "Browse...";
                        clicked => { root.browse-clicked(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                if root.show-error: HorizontalLayout {
                    Text {
                        text: root.error-message;
                        font-size: 12px;
                        color: #cc0000;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    StandardButton { kind: cancel; clicked => { root.dismissed(); } }
                    StandardButton { kind: ok; primary: true; clicked => { root.accepted(); } }
                }
            }
        }
    }
}
