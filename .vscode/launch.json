{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Create Package",
            "type": "debugpy",
            "request": "launch",
            "module": "hatch",
            "console": "integratedTerminal",
            "args": ["build", "--target", "kicad-package"]
        },
        {
            "name": "Run Plugin",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "kicad_xyce_plugin",
            "console": "integratedTerminal",
            "env": {
                "KICAD_API_SOCKET": "ipc:///tmp/kicad/api.sock",
                "KICAD_API_TOKEN": "017a57c0-2ca2-4276-8dd7-83a63fc16f2d"
            },
            "args": ["--log-level=DEBUG"],
            "justMyCode": false
        },
        {
            "name": "Run App",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "kicad_xyce_plugin",
            "console": "integratedTerminal",
            "args": ["--log-level=DEBUG"],
            "justMyCode": false
        }
    ]
}