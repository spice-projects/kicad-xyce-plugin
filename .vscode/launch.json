{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "kicad-xyce-plugin (lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "kicad-xyce-plugin-tests (lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/tests/kicad-xyce-plugin-tests",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "kicad-xyce-plugin (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false
        },
        {
            "name": "Run Plugin",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "kicad_xyce_plugin",
            "console": "integratedTerminal",
            "env": {
                "KICAD_API_SOCKET": "ipc:///tmp/kicad/api.sock",
                "KICAD_API_TOKEN": "",
                "KIPRJMOD": ""
            },
            "args": [
                "--log-level=DEBUG"
            ],
            "justMyCode": true
        },
        {
            "name": "Run App",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "kicad_xyce_plugin",
            "console": "integratedTerminal",
            "args": [
                "--log-level=DEBUG"
            ],
            "justMyCode": true
        },
        {
            "name": "Run App (Profiler)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "command": "${workspaceFolder}/.venv/bin/python -m cProfile -o ${workspaceFolder}/.plugin.prof -s cumtime -m kicad_xyce_plugin --log-level=DEBUG"
        }
    ]
}