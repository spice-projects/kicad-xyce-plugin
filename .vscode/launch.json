{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "kicad-xyce-plugin",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin",
            "linux": {
                "MIMode": "gdb"
            },
            "windows": {
                "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin.exe"
            },
            "args": [
                "--log-level=debug"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            // "envFile": "${workspaceFolder}/.env",
            "externalConsole": false,
            "MIMode": "lldb"
        },        
        {
            "name": "kicad-xyce-plugin (plugin)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin",
            "linux": {
                "MIMode": "gdb"
            },
            "windows": {
                "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin.exe"
            },
            "args": [
                "--log-level=debug"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "kicad-xyce-plugin-tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/tests/kicad-xyce-plugin-tests",
            "linux": {
                "MIMode": "gdb"
            },
            "windows": {
                "program": "${workspaceFolder}/.build-debug/tests/kicad-xyce-plugin-tests.exe"
            },
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "python: unittest test",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "${input:pythonTestId}",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "pythonTestId",
            "type": "promptString",
            "description": "dotted test id, e.g. automation_tests.integration.toolbar_test.ToolbarInitialChecks.test_toolbar_contains_nine_tools_in_expected_state",
            "default": "automation_tests.integration.toolbar_test.ToolbarInitialChecks.test_toolbar_contains_nine_tools_in_expected_state"
        }
    ]
}