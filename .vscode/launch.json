{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "kicad-xyce-plugin (lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin",
            "linux": {
                "MIMode": "gdb"
            },
            "windows": {
                "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin.exe"
            },
            "args": [
                "--log-level=debug"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            // "envFile": "${workspaceFolder}/.env",
            "externalConsole": false,
            "MIMode": "lldb"
        },        
        {
            "name": "kicad-xyce-plugin (plugin)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin",
            "linux": {
                "MIMode": "gdb"
            },
            "windows": {
                "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin.exe"
            },
            "args": [
                "--log-level=debug"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            // "envFile": "${workspaceFolder}/.env",
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "kicad-xyce-plugin (profile)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-profile/kicad-xyce-plugin",
            "windows": {
                "program": "${workspaceFolder}/.build-profile/kicad-xyce-plugin.exe"
            },
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LLVM_PROFILE_FILE",
                    "value": "${workspaceFolder}/.plugin.profraw"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "kicad-xyce-plugin-tests (lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/tests/kicad-xyce-plugin-tests",
            "linux": {
                "MIMode": "gdb"
            },
            "windows": {
                "program": "${workspaceFolder}/.build-debug/tests/kicad-xyce-plugin-tests.exe"
            },
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "kicad-xyce-plugin (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build-debug/kicad-xyce-plugin.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false
        }
    ]
}